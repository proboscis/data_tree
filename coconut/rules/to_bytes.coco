import io

import PIL
from PIL import Image


def to_image_bytes(img:PIL.Image.Image,format)->bytes:
    buf = io.BytesIO()
    img.save(buf,format)
    return buf.getvalue()
def from_jpg_bytes(bs:bytes)->PIL.Image.Image:
    return Image.open(io.BytesIO(bs))

def rule_image_str_to_jpg_bytes(state):
    case state:
        match "image,RGB,RGB":
            return [
                (i -> to_image_bytes(i,"jpeg"),
            "jpg_bytes",
            "image to jpg bytes",
            1)
            ]
        match "jpg_bytes":
            return [
                (from_jpg_bytes,
                "image,RGB,RGB",
                "jpg bytes to Image",
                1)
            ]
